# --- Claude (leave blank to use the offline keyword classifier) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Zendesk (leave blank to skip ticket updates) ---
ZENDESK_SUBDOMAIN=yourcompany
ZENDESK_EMAIL=triage-bot@yourcompany.com
ZENDESK_API_TOKEN=
# Signing secret shown on the webhook's page in Zendesk Admin Center
ZENDESK_WEBHOOK_SECRET=

# --- Slack (leave blank to skip alerts) ---
SLACK_WEBHOOK_URL=
# low | normal | high | urgent  -> minimum urgency that gets posted
SLACK_ALERT_MIN_URGENCY=high

# --- App ---
DEMO_MODE=true
LOG_LEVEL=INFO
